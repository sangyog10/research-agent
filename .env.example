# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your own values:
#     cp .env.example .env
# `.env` is git-ignored and loaded automatically at import time.
# ---------------------------------------------------------------------------

# REQUIRED - free API key from https://console.groq.com/keys
GROQ_API_KEY=

# Optional - any model available on Groq.
# See https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-20b

# Optional - 0.0 is deterministic, 1.0 is creative.
LLM_TEMPERATURE=0.3

# ---------------------------------------------------------------------------
# Email delivery (only used by the email agent).
# Leave RESEND_API_KEY empty to run in dry-run mode: the agent does everything
# except the final network call, so the workflow is safe to demo.
# ---------------------------------------------------------------------------

# Optional - API key from https://resend.com/api-keys
RESEND_API_KEY=

# Optional - must be a verified domain on your Resend account.
# The default sandbox sender only delivers to your own Resend signup address.
EMAIL_FROM=onboarding@resend.dev
